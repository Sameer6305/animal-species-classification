# Copy to backend/.env (gitignored) and fill in. Never commit real keys.
# All variables are optional; without a Groq key the chat uses the retrieval-only fallback.

# Groq free tier (no card): https://console.groq.com/keys  (GROQ_API_KEY is also accepted)
WILDLENS_GROQ_API_KEY=
# WILDLENS_GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (optional, offline LLM). Leave empty to disable.
WILDLENS_OLLAMA_URL=
# WILDLENS_OLLAMA_MODEL=llama3.2

# Chat limits
# WILDLENS_CHAT_RATE_LIMIT_PER_MINUTE=20
# WILDLENS_CHAT_TIMEOUT_S=45
